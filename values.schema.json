{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "nonNegativeInt": { "type": "integer", "minimum": 0 }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "azp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://.+[^/])?$",
          "description": "Empty, or an https URL without a trailing slash"
        },
        "pool": { "type": "string" },
        "existingSecret": { "type": "string" },
        "token": { "type": "string" }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poolID": { "type": "string", "pattern": "^[0-9]*$" },
        "minReplicaCount": { "$ref": "#/definitions/nonNegativeInt" },
        "maxReplicaCount": { "type": "integer", "minimum": 1 },
        "pollingInterval": { "type": "integer", "minimum": 1 },
        "strategy": { "type": "string", "enum": ["default", "accurate", "eager"] },
        "demands": { "type": "string" },
        "successfulJobsHistoryLimit": { "$ref": "#/definitions/nonNegativeInt" },
        "failedJobsHistoryLimit": { "$ref": "#/definitions/nonNegativeInt" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeDeadlineSeconds": { "$ref": "#/definitions/nonNegativeInt" },
        "ttlSecondsAfterFinished": { "$ref": "#/definitions/nonNegativeInt" },
        "terminationGracePeriodSeconds": { "$ref": "#/definitions/nonNegativeInt" }
      }
    },
    "templateAgent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "useAsParent": { "type": "boolean" }
      }
    },
    "workVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?)?$" }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
